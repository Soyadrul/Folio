<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Only the small settings file is worth restoring. Extracted EPUBs live
         in the cache directory and absolute library paths are re-validated on
         startup, so neither the `file` nor `external` domain is transferred. -->
    <cloud-backup>
        <include domain="sharedpref" path="." />
    </cloud-backup>

    <!-- Device-to-device transfer (Android 12+). -->
    <device-transfer>
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
