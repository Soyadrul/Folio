<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 10 (API 29) and older: READ_EXTERNAL_STORAGE is enough for
         direct path access. Android 11+ (API 30): all-files access is required
         for non-media files such as .epub; the activity reports Build.VERSION
         so the app can ask for the right permission. The flag is requested
         dynamically, never assumed. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:label="Folio"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true">
        <!-- android:roundIcon="@mipmap/ic_launcher_round"
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Opt in to edge-to-edge rendering (needed for immersive reader) -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Allow opening .epub files from other apps (Files, e-mail, etc.) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/epub+zip" />
                <data android:scheme="file" android:mimeType="application/epub+zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Some file managers report EPUBs as octet-stream; the path
                     pattern makes the extension match in that case. -->
                <data
                    android:scheme="content"
                    android:mimeType="application/octet-stream"
                    android:pathPattern=".*\\.epub" />
                <data android:scheme="file" android:pathPattern=".*\\.epub" />
            </intent-filter>
        </activity>

        <!-- Flutter embedding metadata (not a notification/keep-screen flag;
             the reader's screen flag is set from MainActivity). -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

    <!-- permission_handler is compiled against a newer SDK than some devices
         targeted by the app; allow it to be linked. -->
    <uses-sdk tools:overrideLibrary="io.flutter.plugins.permissionhandler" />

</manifest>
